# Copy this file to .env and fill in your values

# Redis (auto-configured by Docker Compose — do not change)
REDIS_URL=redis://redis:6379

# Comma-separated browser origins allowed to call the API directly.
# In normal Docker deployment, users access the API through nginx on port 80.
# Add the customer server URL/IP here if direct API CORS is needed.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Google Vision API credentials file (place google_credentials.json in the MTO/ folder)
# The docker-compose.yml mounts it automatically.
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json

# Optional: set Poppler path if not using system-wide install
# POPPLER_PATH=/usr/bin

# ── Ollama model names ────────────────────────────────────────────────────────
# Instrument classifier / ISA-5.1 enrichment model
XYRA_INSTRUMENT_MODEL=xyra-pid-engineer
# Fallback if the primary model is not built yet
XYRA_INSTRUMENT_MODEL_FALLBACK=qwen2.5:7b
# Line mapper model (instrument-to-pipe-line assignment)
XYRA_LINE_MAPPER_MODEL=xyra-line-mapper
# Fallback for line mapper
XYRA_LINE_MAPPER_MODEL_FALLBACK=qwen2.5:7b
# Project/document context normalizer for uploaded drawings
XYRA_PROJECT_CONTEXT_MODEL=xyra-project-context
XYRA_PROJECT_CONTEXT_MODEL_FALLBACK=qwen2.5:7b
# Keep off for fast deterministic extraction; enable after building the model.
XYRA_PROJECT_CONTEXT_USE_LLM=0

# Client-safe default: system monitor cannot start workers from the browser.
ALLOW_SYSTEM_WORKER_START=false
