# Copy this file to .env and fill in your values

# Redis (auto-configured by Docker Compose — do not change)
REDIS_URL=redis://redis:6379

# Google Vision API credentials file (place google_credentials.json in the MTO/ folder)
# The docker-compose.yml mounts it automatically.
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json

# Optional: set Poppler path if not using system-wide install
# POPPLER_PATH=/usr/bin
