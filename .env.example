# XYRA Studio — environment configuration
# Copy this file to .env and fill in your values before starting the stack.
# Never commit .env to source control.

# ── Deployment ────────────────────────────────────────────────────────────────
ENV=production

# ── Redis ─────────────────────────────────────────────────────────────────────
# Auto-configured by Docker Compose — change only if using an external Redis.
REDIS_URL=redis://redis:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Replace with the actual server IP/hostname in production.
# Example: CORS_ORIGINS=http://192.168.1.100,http://xyra.local
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the Ollama runtime. Use http://ollama:11434 inside Docker Compose.
# Use http://localhost:11434 for local dev.
OLLAMA_HOST=http://localhost:11434

# ── Google Vision (P&ID PDF rendering fallback) ───────────────────────────────
# Path to Google service account credentials JSON file.
# Mount the file into the container via docker-compose.yml volumes.
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json

# ── Poppler (PDF → image rendering) ──────────────────────────────────────────
# Optional: override system Poppler path if not on PATH.
# POPPLER_PATH=/usr/bin

# ── Offline project database ──────────────────────────────────────────────────
# Default and currently enabled storage engine.
XYRA_DB_BACKEND=sqlite

# Path to the SQLite database file (default: backend/data/xyra_studio.db).
# Override to persist data to a mounted volume in production.
# XYRA_DB_PATH=/data/xyra_studio.db

# Reserved for future enterprise adapters: postgresql, mssql, oracle.
# Not enabled in the current offline build.
# XYRA_DATABASE_URL=postgresql://xyra:password@db:5432/xyra_studio

# Default project ID used when no project is specified.
XYRA_DEFAULT_PROJECT_ID=default

# ── Ollama model names ────────────────────────────────────────────────────────
# Instrument classifier / ISA-5.1 enrichment model
XYRA_INSTRUMENT_MODEL=xyra-pid-engineer
# Fallback if the primary model is not built yet
XYRA_INSTRUMENT_MODEL_FALLBACK=qwen2.5:7b
# Line mapper model (instrument-to-pipe-line assignment)
XYRA_LINE_MAPPER_MODEL=xyra-line-mapper
# Fallback for line mapper
XYRA_LINE_MAPPER_MODEL_FALLBACK=qwen2.5:7b
# Project/document context normalizer for uploaded drawings
XYRA_PROJECT_CONTEXT_MODEL=xyra-project-context
XYRA_PROJECT_CONTEXT_MODEL_FALLBACK=qwen2.5:7b
# Piping MTO reviewer/enricher model
XYRA_MTO_REVIEWER_MODEL=xyra-mto-reviewer
XYRA_MTO_REVIEWER_MODEL_FALLBACK=qwen2.5:7b
# AI Grid engineering team reviewer models
XYRA_INSTRUMENTATION_ENGINEER_MODEL=xyra-instrumentation-engineer
XYRA_PROCESS_ENGINEER_MODEL=xyra-process-engineer
XYRA_PIPING_ENGINEER_MODEL=xyra-piping-engineer
# Offline project-context assistant mode:
# auto = use xyra-project-context only when deterministic title-block extraction is incomplete
# 1/always = run on every PDF; 0/never = deterministic extraction only
XYRA_PROJECT_CONTEXT_USE_LLM=auto
# First local model call can be slow on smaller customer workstations.
XYRA_PROJECT_CONTEXT_TIMEOUT_SECONDS=45
# Default second-pass AI review for Piping MTO detections/results.
XYRA_MTO_REVIEW_USE_LLM=1
# MTO reviewer can need extra time when Ollama is cold or many examples are loaded.
XYRA_MTO_REVIEW_TIMEOUT_SECONDS=60

# Client-safe default: system monitor cannot start workers from the browser.
ALLOW_SYSTEM_WORKER_START=false
