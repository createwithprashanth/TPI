# XYRA Studio — deployment environment template
# Copy to .env and fill in values before starting the stack.
# Never commit .env to source control.

# ── Deployment ────────────────────────────────────────────────────────────────

ENV=production

# CORS origins allowed to call the API.
# !! REQUIRED: replace with the exact URL the browser uses to reach this server.
# Comma-separated if multiple (e.g. LAN IP + hostname):
#   CORS_ORIGINS=http://192.168.1.100,http://xyra.local
# The nginx proxy already handles same-origin API calls — this is a defence-in-depth
# setting. Leaving this as localhost will trigger a startup warning in production.
CORS_ORIGINS=http://YOUR_SERVER_IP

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379

# ── Ollama / LLM ──────────────────────────────────────────────────────────────

OLLAMA_HOST=http://ollama:11434

# Custom model names (defaults shown — only change if you renamed the models)
# XYRA_INSTRUMENT_MODEL=xyra-pid-engineer
# XYRA_LINE_MAPPER_MODEL=xyra-line-mapper
# XYRA_PROJECT_CONTEXT_MODEL=xyra-project-context
# XYRA_MTO_REVIEWER_MODEL=xyra-mto-reviewer

# Enable LLM-assisted project context normalisation on every PDF upload.
# Set to 1 once xyra-project-context is confirmed working for your drawings.
XYRA_PROJECT_CONTEXT_USE_LLM=0

# Enable LLM-assisted review/enrichment for Piping MTO detections.
# Results are reviewed before display when the model is available.
XYRA_MTO_REVIEW_USE_LLM=1

# ── Google Vision (OCR fallback for scanned/raster P&IDs) ────────────────────

# Path inside the container — leave as-is; the file is mounted as a volume.
GOOGLE_APPLICATION_CREDENTIALS=/app/google_credentials.json

# ── System / Admin ────────────────────────────────────────────────────────────

# Allow the System Health dashboard to start a new RQ worker via the API.
# Set to true only on the engineer's own workstation; keep false for client installs.
ALLOW_SYSTEM_WORKER_START=false

# Print per-page debug JPEGs to batch_outputs/ during extraction.
# Useful for diagnosing missed instruments. Off in production.
INSTRUMAP_DEBUG=false

# PDF rendering resolution. 300 is the standard for P&ID work.
PDF_DPI=300
