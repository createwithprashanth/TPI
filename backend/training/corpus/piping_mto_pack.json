{
  "pack_id": "piping_mto_epc_core",
  "version": 1,
  "model_targets": ["xyra-mto-reviewer", "xyra-piping-engineer", "xyra-process-engineer", "xyra-line-mapper"],
  "sources": ["aiche-pid-codes-tags-labels", "projectmaterials-line-designation", "emerson-control-valve-sizing", "emerson-control-valve-handbook", "pid-digitization-research", "ossr-pid-research"],
  "rules": [
    "Piping MTO should separate deterministic symbol detection from engineering review.",
    "Accept size only from explicit inch-mark text near the component or from the size prefix of a valid line designation.",
    "Nearest text is helpful but must be filtered: note numbers, drawing coordinates, revision values, datasheet-only numbers, and table headers are not component sizes.",
    "Horizontal and vertical component orientations must be treated equivalently when nearby size and line evidence agree.",
    "Line designation can carry size, fluid/service code, sequence, area, spec/class, insulation, and tracing; do not invent missing segments.",
    "Control valves, shutdown valves, relief valves, restriction orifices, flow elements, and manual valves require different downstream handoffs."
  ],
  "examples": [
    {
      "id": "mto-horizontal-ball-valve-size",
      "model_targets": ["xyra-mto-reviewer"],
      "input": {
        "component_label": "BALL VALVE",
        "score": 0.84,
        "detected_size_inch": "0.75",
        "size_source": "3/4\"",
        "nearby_text": ["3/4\"", "2\"-PG-24464-251482-X-N", "BV-001"],
        "metadata": {"itemType": "Ball valve", "pipingClass": "A1A3A-FA", "rating": "150#", "valveBore": "FB", "endConnection": "FLANGED"}
      },
      "expected": {"decision": "ACCEPT", "normalized_size_inch": "0.75", "item_type": "Ball valve"}
    },
    {
      "id": "mto-reject-note-noise",
      "model_targets": ["xyra-mto-reviewer"],
      "input": {
        "component_label": "BALL VALVE",
        "score": 0.59,
        "detected_size_inch": "",
        "size_source": "",
        "nearby_text": ["NOTE 8", "287", "SHEET 1"],
        "metadata": {"itemType": "Ball valve"}
      },
      "expected": {"decision": "REJECT", "review_flags_contains": "NO_COMPONENT_CONTEXT"}
    },
    {
      "id": "piping-psv-relief",
      "model_targets": ["xyra-piping-engineer"],
      "input": {"tag_number": "101-PSV-001", "instrument_type": "PSV", "line_tag": "3-GAS-1001-A1A-N", "flowsizing_type": ""},
      "expected": {"flowsizing_type": "relief-valve"}
    }
  ],
  "benchmark_cases": [
    {
      "id": "eng-pipe-psv-relief",
      "suite": "engineering_team",
      "model": "xyra-piping-engineer",
      "role": "piping",
      "row": {"id": "pipe-psv", "tag_number": "101-PSV-001", "instrument_type": "PSV", "line_tag": "3-GAS-1001-A1A-N", "flowsizing_type": ""},
      "expected": [["flowsizing_type", "relief-valve"]]
    },
    {
      "id": "eng-process-xfd-no-service",
      "suite": "engineering_team",
      "model": "xyra-process-engineer",
      "role": "process",
      "row": {"id": "proc-xfd", "tag_number": "101-XFD-001", "instrument_type": "XFD", "service": "", "line_tag": "2-PG-24464-251482-X-N", "review_required": false},
      "expected": [["review_required", true]]
    }
  ]
}
