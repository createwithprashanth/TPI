{
  "pack_id": "instrumentation_epc_core",
  "version": 1,
  "model_targets": ["xyra-pid-engineer", "xyra-instrumentation-engineer", "xyra-line-mapper"],
  "sources": ["isa-5-1-official", "isa-5-series-official", "pid-digitization-research"],
  "rules": [
    "Treat client legend/project context as higher priority than generic ISA-style defaults.",
    "Classify multi-letter type codes from the whole code, not the final letter alone.",
    "Passive items such as FE, RO, TE, TW, PG, TG, LG, PSV are engineering objects but normally have no IO point by themselves.",
    "DCS-only controllers, indicators tied to transmitters, recorders, and alarm setpoints are soft functions and should not be counted as field devices.",
    "F&G tags such as XFD, XGD, XHMD, and XTGD are area devices and should not receive process line service unless the project legend explicitly says otherwise.",
    "Noisy drawing text, revision marks, note numbers, title-block fragments, and drawing references must become review rows, not instrument rows."
  ],
  "examples": [
    {
      "id": "inst-passive-te",
      "model_targets": ["xyra-instrumentation-engineer"],
      "input": {"tag_number": "101-TE-002", "instrument_type": "TE", "io_type": "", "signal_type": ""},
      "expected": {"io_type": "None", "signal_type": "None", "category": "passive"}
    },
    {
      "id": "inst-fg-area",
      "model_targets": ["xyra-line-mapper", "xyra-process-engineer"],
      "input": {"tag_number": "101-XFD-001", "instrument_type": "XFD", "line_candidates": [{"line": "2-PG-24464-251482-X-N", "dist_px": 140}]},
      "expected": {"line_number": "", "reason_contains": "area"}
    },
    {
      "id": "inst-soft-controller",
      "model_targets": ["xyra-instrumentation-engineer"],
      "input": {"tag_number": "101-PIC-001", "instrument_type": "PIC", "io_type": "", "category": ""},
      "expected": {"io_type": "Soft Link", "category": "controller"}
    },
    {
      "id": "inst-negative-note",
      "model_targets": ["xyra-pid-engineer", "xyra-instrumentation-engineer"],
      "input": {"tag_number": "NOTE 23", "instrument_type": "", "status": ""},
      "expected": {"review_required": true, "status": "For Review"}
    }
  ],
  "benchmark_cases": [
    {
      "id": "eng-inst-TE-passive",
      "suite": "engineering_team",
      "model": "xyra-instrumentation-engineer",
      "role": "instrumentation",
      "row": {"id": "inst-te", "tag_number": "101-TE-002", "instrument_type": "TE", "io_type": "", "signal_type": "", "category": ""},
      "expected": [["io_type", "None"], ["signal_type", "None"], ["category", "passive"]]
    },
    {
      "id": "line-fg-empty",
      "suite": "line_mapper",
      "tag": "XFD-573P-05",
      "type": "XFD",
      "candidates": [{"line": "2-PO-33458-251441-J-N", "dist_px": 120}],
      "expect": {"line_number": "", "confidence_min": 0.95}
    }
  ]
}
