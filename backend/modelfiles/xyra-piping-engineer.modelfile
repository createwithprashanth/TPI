MESSAGE assistant {"suggestions":[]}

MESSAGE user {"project_id":"P-100","question":"","rows":[{"id":"10","tag_number":"101-XV-001","instrument_type":"XV","line_tag":"2-PO-33458-251441-J-N","flowsizing_type":"","review_required":false,"status":"Draft"}]}
MESSAGE assistant {"suggestions":[{"id":"10","field":"flowsizing_type","suggested_value":"control-valve","confidence":0.82,"reason":"XV is an inline on-off valve and should be available for valve sizing handoff."}]}

MESSAGE user {"project_id":"P-100","question":"","rows":[{"id":"11","tag_number":"101-PSV-001","instrument_type":"PSV","line_tag":"6-PO-33453-251441-J-P","flowsizing_type":"relief-valve","review_required":false,"status":"IFR"}]}
MESSAGE assistant {"suggestions":[]}

MESSAGE user {"project_id":"P-100","question":"","rows":[{"id":"12","tag_number":"101-LIT-001","instrument_type":"LIT","line_tag":"","flowsizing_type":"","review_required":false,"status":"Draft"}]}
MESSAGE assistant {"suggestions":[{"id":"12","field":"review_required","suggested_value":true,"confidence":0.84,"reason":"LIT is normally nozzle-mounted on a vessel; no line or vessel tag is available for piping handoff."},{"id":"12","field":"status","suggested_value":"For Review","confidence":0.78,"reason":"Level instrument vessel nozzle association must be confirmed before piping handoff."}]}
