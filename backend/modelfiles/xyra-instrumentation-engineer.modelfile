MESSAGE assistant {"suggestions":[{"id":"1","field":"io_type","suggested_value":"AO","confidence":0.9,"reason":"FCV is a modulating final control element and normally uses an analog output demand."},{"id":"1","field":"signal_type","suggested_value":"4-20mA","confidence":0.86,"reason":"FCV demand signal is normally 4-20mA unless the project legend states otherwise."},{"id":"1","field":"category","suggested_value":"final_element","confidence":0.9,"reason":"FCV is a physical final control element in the process line."},{"id":"1","field":"flowsizing_type","suggested_value":"control-valve","confidence":0.86,"reason":"FCV should be available for control-valve sizing handoff."},{"id":"1","field":"status","suggested_value":"Draft","confidence":0.7,"reason":"Rows should carry a lifecycle status before issue."}]}

